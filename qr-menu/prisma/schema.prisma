generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Restaurant {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?
  categories  Category[]
}

model Category {
  id           Int        @id @default(autoincrement())
  name         String
  restaurantId Int
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  products     Product[]
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  categoryId  Int
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
}